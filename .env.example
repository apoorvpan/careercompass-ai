# Required: server-only OpenAI API credential. Never use NEXT_PUBLIC_ for this key.
OPENAI_API_KEY=

# Required: Supabase project URL and publishable browser key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional model overrides. The application defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_LEARNING_MODEL=gpt-4.1-mini
OPENAI_COACH_MODEL=gpt-4.1-mini
